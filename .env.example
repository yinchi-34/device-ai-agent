DEVICE_DATABASE_NAME=device_ai_agent
DEVICE_TEST_DATABASE_NAME=device_ai_agent_test
DEVICE_DATABASE_USER=device
DEVICE_DATABASE_PASSWORD=replace-with-a-local-secret
DEVICE_DATABASE_PORT=5433
DEVICE_API_PORT=8000
DEVICE_ADMIN_USERNAME=admin
DEVICE_ADMIN_PASSWORD=replace-with-a-strong-admin-secret

# Identity provider (OIDC). These defaults use the local Keycloak started by
# the local-idp profile; for a real provider copy the endpoints from its
# /.well-known/openid-configuration and drop COMPOSE_PROFILES.
COMPOSE_PROFILES=local-idp
DEVICE_OIDC_ISSUER=http://localhost:8180/realms/device
DEVICE_OIDC_AUDIENCE=device-control-api
DEVICE_OIDC_LOGIN_URL=http://localhost:8180/realms/device/protocol/openid-connect/auth
DEVICE_OIDC_TOKEN_URL=http://keycloak:8080/realms/device/protocol/openid-connect/token
DEVICE_OIDC_JWKS_URL=http://keycloak:8080/realms/device/protocol/openid-connect/certs

# Gateway (Caddy + oauth2-proxy).
DEVICE_GATEWAY_PUBLIC_URL=http://localhost:8000
DEVICE_GATEWAY_CLIENT_SECRET=local-dev-gateway-secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
DEVICE_GATEWAY_COOKIE_SECRET=local-dev-cookie-secret-32-bytes
# false only for local plain-HTTP use.
DEVICE_GATEWAY_COOKIE_SECURE=false
# Clients allowed to reach the gateway (Caddy remote_ip syntax).
DEVICE_GATEWAY_ALLOWED_CIDRS=private_ranges

DEVICE_DOCUMENT_MAX_FILE_BYTES=26214400
DEVICE_DOCUMENT_MAX_PDF_PAGES=300
DEVICE_DOCUMENT_MIN_TEXT_CHARS_PER_PAGE=40
DEVICE_DOCUMENT_TASK_VISIBILITY_TIMEOUT_SECONDS=21600
DEVICE_DOCUMENT_LLM_BASE_URL=https://api.openai.com/v1
DEVICE_DOCUMENT_LLM_API_KEY=
DEVICE_DOCUMENT_LLM_MODEL=
DEVICE_DOCUMENT_LLM_TIMEOUT_SECONDS=600
DEVICE_DOCUMENT_LLM_MAX_OUTPUT_TOKENS=8192
DEVICE_DOCUMENT_EXTRACTION_GROUP_MAX_TOKENS=2000
DEVICE_DOCUMENT_VISION_BASE_URL=https://api.openai.com/v1
DEVICE_DOCUMENT_VISION_API_KEY=
DEVICE_DOCUMENT_VISION_MODEL=
DEVICE_DOCUMENT_VISION_TIMEOUT_SECONDS=120
DEVICE_DOCUMENT_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
DEVICE_DOCUMENT_EMBEDDING_API_KEY=
DEVICE_DOCUMENT_EMBEDDING_MODEL=bge-m3
DEVICE_DOCUMENT_EMBEDDING_TIMEOUT_SECONDS=300

DEVICE_DIAGNOSIS_LLM_BASE_URL=https://api.openai.com/v1
DEVICE_DIAGNOSIS_LLM_API_KEY=
DEVICE_DIAGNOSIS_LLM_MODEL=
DEVICE_DIAGNOSIS_LLM_TIMEOUT_SECONDS=120
DEVICE_DIAGNOSIS_READ_GATEWAY_URL=
DEVICE_DIAGNOSIS_READ_GATEWAY_TOKEN=
DEVICE_DIAGNOSIS_READ_GATEWAY_TIMEOUT_SECONDS=10
